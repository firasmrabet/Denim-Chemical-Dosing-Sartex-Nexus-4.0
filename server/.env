# ==========================================
# CONFIGURATION DE LA CONNEXION MODBUS (PLC)
# ==========================================

# Mode de connexion ("RTU" pour Câble USB/Série, "TCP" pour Réseau Wi-Fi/Ethernet via HMI)
CONNECTION_MODE=RTU

# ------------------------------------------
# Paramètres pour le mode TCP (Wi-Fi)
# ------------------------------------------
# L'adresse IP de votre écran HMI (DOP-107EG)
HMI_IP=192.168.2.50
MODBUS_PORT=502

# ------------------------------------------
# Paramètres pour le mode RTU (Câble)
# ------------------------------------------
PORT_SERIE=COM3
BAUD_RATE=9600

# ==========================================
# AUTRES CONFIGURATIONS
# ==========================================
PORT=3001
